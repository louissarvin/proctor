    classDef verify fill:#1e3a8a,stroke:#60a5fa,color:#fff
    classDef closed fill:#78350f,stroke:#f59e0b,color:#fff
    classDef pay fill:#3b0764,stroke:#a855f7,color:#fff
    class A2 hold
    class B,H,T,S,F chain
