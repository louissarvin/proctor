# Proctor web: witness PWA + evidence console

# The Proctor API.
VITE_API_URL="http://localhost:3700"

# World ID application id. PUBLIC and safe to expose.
# The RP SIGNING KEY is server-only and must never appear in a VITE_ variable:
# if it leaks, anyone can forge proof requests from your app.
VITE_WORLD_APP_ID=""

# DEVICE until the Selfie Check beta flag is granted, then SELFIE.
# The verification path is identical either way.
VITE_WORLD_MODE="DEVICE"
