{
  "name": "backend-starter",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:push": "bunx prisma db push --config prisma/prisma.config.ts && bunx prisma generate --config prisma/prisma.config.ts && bun run db:constraints",
    "db:pull": "bunx prisma db pull --config prisma/prisma.config.ts",
    "db:generate": "bunx prisma generate --config prisma/prisma.config.ts",
    "db:migrate": "bunx prisma migrate dev --name init --config prisma/prisma.config.ts",
    "seed": "bun scripts/seed.ts",
    "demo": "bun scripts/demo.ts",
    "open": "bun scripts/open-decision.ts",
    "marketplace": "bun scripts/marketplace.ts",
    "arc:register": "bun scripts/arc-register.ts",
    "topic:create": "bun scripts/create-topic.ts",
    "db:constraints": "psql \"$(grep '^DATABASE_URL' .env | cut -d'\"' -f2 | sed 's/?schema=public//')\" -v ON_ERROR_STOP=1 -f prisma/sql/001_counter_monotonic.sql",
    "doctor": "bun scripts/doctor.ts",
    "acceptance": "bun scripts/acceptance.ts",
    "token:create": "bun scripts/create-gate-token.ts",
    "token:fund": "bun scripts/fund-agent.ts",
    "retainer": "bun scripts/schedule-retainer.ts",
    "arc:deposit": "bun scripts/arc-deposit.ts",
    "rehearse": "bun scripts/rehearse.ts",
    "e2e": "bun scripts/e2e.ts",
    "live": "bun scripts/demo-live.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "9.8.1",
    "@hiero-ledger/sdk": "2.85.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@solana/wallet-standard-util": "^1.1.2",
    "@solana/web3.js": "^1.98.0",
    "@worldcoin/idkit-core": "4.2.4",
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/extensions": "2.24.0",
    "@x402/fastify": "2.24.0",
    "@x402/fetch": "2.24.0",
    "@x402/hedera": "2.24.0",
    "axios": "^1.7.9",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "fastify": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "viem": "^2",
    "web-push": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "latest",
    "eslint": "^8.57.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "@hiero-ledger/sdk": "2.85.0"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}