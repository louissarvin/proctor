# Proctor backend configuration.
#
# ONLY DATABASE_URL AND JWT_SECRET ARE REQUIRED.
#
# Everything else is optional and each missing value disables exactly one leg,
# loudly, rather than crashing. With none of them set you can still run the full
# oversight loop:
#
#   bun install && bun run db:push && bun run seed && bun run demo
#
# ...but the record it produces is NOT independently verifiable, because it is
# signed with a published demo key and never reaches a topic. `bun run doctor`
# says which of the two you have. That distinction is the whole product, so the
# tooling refuses to blur it.

# --- required ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proctor"
JWT_SECRET="change-me"

# --- app --------------------------------------------------------------------
APP_PORT=3700
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Publicly reachable base URL of THIS API. Goes in the A2A agent card, so a card
# with the default localhost value describes a service nothing can reach.
PUBLIC_BASE_URL="http://localhost:3700"
# Where the witness PWA is served.
#
# A PHONE CANNOT RESOLVE YOUR LOCALHOST. The witness flow ends on a phone, so
# this must be an address that phone can actually open:
#   - same wifi:  http://<your-lan-ip>:3200   (vite binds to 0.0.0.0)
#   - anywhere:   an https tunnel or a deployment
#
# The /handoff/<token> screen builds its QR from the page's own origin, so it is
# correct by construction and warns loudly if you opened it on localhost.
WITNESS_APP_URL="http://localhost:3200"

# --- attestation ------------------------------------------------------------
# SECRET. EIP-712 signing key for evidence records. Distinct from the World RP
# key. Without it, records are signed with a PUBLISHED demo key and prove
# nothing about who produced them.
ATTESTOR_PRIVATE_KEY=""

# --- Hedera -----------------------------------------------------------------
# ECDSA secp256k1, NOT ED25519: ED25519 has no EVM alias.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=""
HEDERA_OPERATOR_KEY=""
# The evidence topic. Create one with: bun run topic:create --memo "..." --confirm
# A topic with no admin key is immutable and undeletable BY ANYONE, FOREVER.
HEDERA_TOPIC_ID=""
# The gate's payTo account, and its key (needed only to update the account).
HEDERA_TREASURY_ID=""
HEDERA_TREASURY_KEY=""
# The agent that pays the gate.
HEDERA_AGENT_ID=""
HEDERA_AGENT_KEY=""
# Where the witness fee is paid. HBAR, so no token association is needed and a
# person who has never held a token can still receive it.
WITNESS_HEDERA_ACCOUNT=""
# On-call standby pay per retainer period, in tinybar. Standby, not salary:
# paying only per decision prices availability at zero.
RETAINER_TINYBAR="500000"
MIRROR_NODE_URL="https://testnet.mirrornode.hedera.com"
HASHSCAN_BASE="https://hashscan.io/testnet"

# --- x402 -------------------------------------------------------------------
# Blocky402 is the DEFAULT, not a fallback: Hedera's track names it explicitly.
FACILITATOR_URL="https://api.testnet.blocky402.com"
FACILITATOR_FALLBACK_URL="https://x402.org/facilitator"
PAY_TO_HEDERA=""
GATE_PRICE_USD="0.42"
# USDC or HBAR. USDC on Hedera is an HTS token; a recipient that has never held
# it cannot receive it, so HBAR is the default that always works.
# TOKEN settles in an HTS token you minted (bun run token:create), HBAR needs no
# faucet, USDC needs one that has never delivered on Hedera testnet.
GATE_ASSET="TOKEN"
GATE_PRICE_HBAR_TINYBAR="100000000"
# The HTS token the gate settles in when GATE_ASSET=TOKEN.
GATE_TOKEN_ID=""
# Atomic units at the token's decimals. 420000 = $0.42 at 6dp.
GATE_TOKEN_AMOUNT="420000"
# The meter bills real seconds of human attention. Integer arithmetic only.
METER_RATE_USD_PER_SEC="0.0021"
METER_TINYBAR_PER_SECOND="420000"
# x402 cannot quote a zero amount, so a floor is required.
METER_MIN_TINYBAR="100000"
METER_MODE="HEDERA"

# --- Arc / Circle -----------------------------------------------------------
ARC_RPC_URL="https://rpc.testnet.arc.io"
ARC_CHAIN_ID=5042002
# Circle's Gateway facilitator serves Arc, which Blocky402 does not. NB the
# SDK's own example URL (gateway.circle.com) does not resolve; this one does.
ARC_FACILITATOR_URL="https://gateway-api-testnet.circle.com"
# EOA ONLY. Gateway needs ecrecover; a smart-contract wallet fails silently.
PAY_TO_ARC=""
# SECRET. Owns the ERC-8004 agent identity.
ARC_PRIVATE_KEY=""
ARC_AGENT_ID=""

# --- World ID 4.0 -----------------------------------------------------------
WORLD_APP_ID=""
WORLD_RP_ID=""
# SECRET. Never expose to the client, never log. Mandatory in v4 before the
# widget can open.
WORLD_RP_SIGNING_KEY=""
WORLD_ACTION="proctor-witness-approval"
WORLD_VERIFY_URL="https://developer.world.org"
# production | staging | sandbox.
# Set to "sandbox" when testing against the sandbox World ID app. The proof still
# goes to the PRODUCTION verify endpoint — those two do not move together.
WORLD_ENVIRONMENT="staging"
# DEVICE until the Selfie Check beta flag is granted, then SELFIE. One variable.
WORLD_MODE="DEVICE"

# --- Web Push (VAPID) -------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dev@proctor.local"

# --- policy -----------------------------------------------------------------
# The gate fails CLOSED: no answer inside the TTL is a REFUSE.
DECISION_TTL_SECONDS=60

# --- safety -----------------------------------------------------------------
# Kill switch for HCS writes. Set true so fixtures never reach the evidence log.
ATTEST_DISABLED=""
