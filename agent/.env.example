# Proctor paying agent.
#
# Secrets are copied from backend/.env. This file is gitignored by the root
# .gitignore pattern `.env`, which matches at any depth.

# The API the agent pays. Use the LAN address if you are driving this from
# another machine; a phone cannot resolve your localhost.
PROCTOR_API="http://localhost:3700"

# The Hedera account the gate is paid FROM.
HEDERA_AGENT_ID=""
HEDERA_AGENT_KEY=""

# The agent refuses to pay in an asset its operator has not approved, which is
# the correct default for software that spends money unattended. The gate now
# settles in an HTS token we minted, so that token has to be listed here or
# every payment is rejected by spendControls before it is ever attempted.
AGENT_ALLOWED_TOKENS=""
# Atomic cap per payment for the tokens above. 2000000 = $2 at 6 decimals.
AGENT_MAX_PER_PAYMENT="2000000"

# The Arc rail. EOA only: Circle Gateway verifies with ecrecover, not ERC-1271,
# so a smart-contract wallet signs something that looks fine and is rejected at
# settlement. Payments draw from a Gateway BALANCE, not the wallet balance:
# fund it with `bun run arc:deposit` in backend/.
ARC_PRIVATE_KEY=""
ARC_NETWORK="eip155:5042002"
ARC_MAX_PER_PAYMENT="2000000"

# Which rail to pay on. Unset lets the gate decide (it offers Hedera first).
# Set to eip155:5042002 to force Arc, hedera:testnet to force Hedera.
# PREFER_NETWORK="eip155:5042002"
